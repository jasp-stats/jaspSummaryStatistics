msgstr "输入计算得到的 z 统计量值"

msgctxt "SummaryStatsTestStatistics|"
msgid "t-test"
msgstr "t 检验"

msgctxt "SummaryStatsTestStatistics|"
msgid ""
"Use when sample standard deviation is used to estimate population standard "
"deviation"
msgstr "当使用样本标准差估计总体标准差时使用"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the calculated t-statistic value"
msgstr "输入计算得到的 t 统计量值"

msgctxt "SummaryStatsTestStatistics|"
msgid "df:"
msgstr "自由度："

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the degrees of freedom for the t-test"
msgstr "输入 t 检验的自由度"

msgctxt "SummaryStatsTestStatistics|"
msgid "χ² test"
msgstr "χ² 检验"

msgctxt "SummaryStatsTestStatistics|"
msgid "Use for goodness of fit or independence tests"
msgstr "用于拟合优度或独立性检验"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the calculated chi-squared statistic value"
msgstr "输入计算得到的卡方统计量值"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the degrees of freedom for the chi-squared test"
msgstr "输入卡方检验的自由度"

msgctxt "SummaryStatsTestStatistics|"
msgid "F-test"
msgstr "F 检验"

msgctxt "SummaryStatsTestStatistics|"
msgid "Use for comparing variances or in ANOVA"
msgstr "用于比较方差或方差分析"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the calculated F-statistic value"
msgstr "输入计算得到的 F 统计量值"

msgctxt "SummaryStatsTestStatistics|"
msgid "Numerator df:"
msgstr "分子自由度："

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the numerator degrees of freedom"
msgstr "输入分子自由度"

msgctxt "SummaryStatsTestStatistics|"
msgid "Denominator df:"
msgstr "分母自由度："

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the denominator degrees of freedom"
msgstr "输入分母自由度"

msgctxt "SummaryStatsTestStatistics|"
msgid "Alternative Hypothesis"
msgstr "备择假设"

msgctxt "SummaryStatsTestStatistics|"
msgid ""
"Choose the direction of the alternative hypothesis for directional tests"
msgstr "选择方向检验的备择假设方向"

msgctxt "SummaryStatsTestStatistics|"
msgid "Two-sided"
msgstr "双侧"

msgctxt "SummaryStatsTestStatistics|"
msgid "Test if the parameter differs from the null value in either direction"
msgstr "检验参数是否在任一方向上不同于零值"

msgctxt "SummaryStatsTestStatistics|"
msgid "Greater"
msgstr "大于"

msgctxt "SummaryStatsTestStatistics|"
msgid "Test if the parameter is greater than the null value"
msgstr "检验参数是否大于零值"

msgctxt "SummaryStatsTestStatistics|"
msgid "Less"
msgstr "小于"

msgctxt "SummaryStatsTestStatistics|"
msgid "Test if the parameter is less than the null value"
msgstr "检验参数是否小于零值"
