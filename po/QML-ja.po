msgid "S.S. Test Statistics"
msgstr "要約統計量からの検定統計量"

msgctxt "SummaryStatsTestStatistics|"
msgid "Test Type"
msgstr "検定の種類"

msgctxt "SummaryStatsTestStatistics|"
msgid "Select the type of statistical test to analyze"
msgstr "分析する統計的検定の種類を選びます"

msgctxt "SummaryStatsTestStatistics|"
msgid "z-test"
msgstr "z検定"

msgctxt "SummaryStatsTestStatistics|"
msgid "Use when population standard deviation is known"
msgstr "母集団の標準偏差が既知のときに使います"

msgctxt "SummaryStatsTestStatistics|"
msgid "Test statistic:"
msgstr "検定統計量:"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the calculated z-statistic value"
msgstr "計算済みのz統計量の値を入力します"

msgctxt "SummaryStatsTestStatistics|"
msgid "t-test"
msgstr "t検定"

msgctxt "SummaryStatsTestStatistics|"
msgid ""
"Use when sample standard deviation is used to estimate population standard "
"deviation"
msgstr "標本の標準偏差から母集団の標準偏差を推定するときに使います"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the calculated t-statistic value"
msgstr "計算済みのt統計量の値を入力します"

msgctxt "SummaryStatsTestStatistics|"
msgid "df:"
msgstr "df:"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the degrees of freedom for the t-test"
msgstr "t検定の自由度を入力します"

msgctxt "SummaryStatsTestStatistics|"
msgid "χ² test"
msgstr "χ²検定"

msgctxt "SummaryStatsTestStatistics|"
msgid "Use for goodness of fit or independence tests"
msgstr "適合度検定や独立性の検定に使います"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the calculated chi-squared statistic value"
msgstr "計算済みのカイ二乗統計量の値を入力します"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the degrees of freedom for the chi-squared test"
msgstr "カイ二乗検定の自由度を入力します"

msgctxt "SummaryStatsTestStatistics|"
msgid "F-test"
msgstr "F検定"

msgctxt "SummaryStatsTestStatistics|"
msgid "Use for comparing variances or in ANOVA"
msgstr "分散の比較や分散分析で使います"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the calculated F-statistic value"
msgstr "計算済みのF統計量の値を入力します"

msgctxt "SummaryStatsTestStatistics|"
msgid "Numerator df:"
msgstr "分子の df:"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the numerator degrees of freedom"
msgstr "分子の自由度を入力します"

msgctxt "SummaryStatsTestStatistics|"
msgid "Denominator df:"
msgstr "分母の df:"

msgctxt "SummaryStatsTestStatistics|"
msgid "Enter the denominator degrees of freedom"
msgstr "分母の自由度を入力します"

msgctxt "SummaryStatsTestStatistics|"
msgid "Alternative Hypothesis"
msgstr "対立仮説"

msgctxt "SummaryStatsTestStatistics|"
msgid ""
"Choose the direction of the alternative hypothesis for directional tests"
msgstr "片側検定のとき、対立仮説の向きを選びます"

msgctxt "SummaryStatsTestStatistics|"
msgid "Two-sided"
msgstr "両側"

msgctxt "SummaryStatsTestStatistics|"
msgid "Test if the parameter differs from the null value in either direction"
msgstr "パラメータが帰無値と、どちらかの向きに異なるかを検定します"

msgctxt "SummaryStatsTestStatistics|"
msgid "Greater"
msgstr "大きい"

msgctxt "SummaryStatsTestStatistics|"
msgid "Test if the parameter is greater than the null value"
msgstr "パラメータが帰無値より大きいかを検定します"

msgctxt "SummaryStatsTestStatistics|"
msgid "Less"
msgstr "小さい"

msgctxt "SummaryStatsTestStatistics|"
msgid "Test if the parameter is less than the null value"
msgstr "パラメータが帰無値より小さいかを検定します"
