msgstr "التوزيع القبلي للمستخدم"

msgid "wide prior"
msgstr "توزيع قبلي واسع"

msgid "ultrawide prior"
msgstr "توزيع قبلي بالغ الاتساع"

msgid "%1$s at r==%2$s"
msgstr "%1$s عند r==%2$s"

msgid "Cauchy prior width"
msgstr "عرض توزيع كوشي القبلي"

msgid "For all tests, the alternative hypothesis specifies that group 1 is greater than group 2."
msgstr ""
"وبالنسبة لجميع الاختبارات، فإن الفرضية البديلة يحدد أن المجموعة 1 أكبر من "
"المجموعة 2."

msgid "For all tests, the alternative hypothesis specifies that the mean is greater than 0."
msgstr "بالنسبة لجميع الاختبارات، تنص الفرضية البديلة على أن المتوسط أكبر من 0."

msgid "For all tests, the alternative hypothesis specifies that measure 1 is greater than measure 2."
msgstr ""
"في جميع الاختبارات، تنص الفرضية البديلة على أن القياس 1 أكبر من القياس 2."

msgid "For all tests, the alternative hypothesis specifies that group 1 is less than group 2."
msgstr ""
"وبالنسبة لجميع الاختبارات، فإن الفرضية البديلة يحدد أن المجموعة 1 أقل من "
"المجموعة 2."

msgid "For all tests, the alternative hypothesis specifies that the mean is less than 0."
msgstr ""
"بالنسبة لجميع الاختبارات، فإن الفرضية البديلة يحدد أن المتوسط هو أقل من 0."

msgid "For all tests, the alternative hypothesis specifies that measure 1 is less than measure 2."
msgstr "لجميع الاختبارات، تنص الفرضية البديلة على أن القياس 1 أقل من القياس 2."

msgid "Bayesian One Sample T-Test"
msgstr "اختبار t البايزي لعينة واحدة"

msgid "Bayesian Paired Samples T-Test"
msgstr "اختبار t البايزي لعينتين مرتبطتين"

msgid "Not enough observations."
msgstr "مشاهدات غير كافية."

msgid "Model Summary"
msgstr "ملخص النموذج"

msgid "Effect size"
msgstr "حجم الأثر"

msgid "Standard error"
msgstr "الخطأ المعياري"

msgid "Max %1$s"
msgstr "الحد الأقصى لـ%1$s"

msgid "Default %1$s"
msgstr "افتراضي %1$s"

msgid "exp(Effect size)"
msgstr "exp(حجم الأثر)"

msgid "Bayes Factor Robustness Plot"
msgstr "مخطط حصانة عامل بايز"

msgid "Bayes factor contours breaks could not be parsed into numbers."
msgstr "تعذّر تفسير قيم فواصل خطوط كنتور عامل بايز كأعداد."

msgid "Bayes factor contours breaks must be positive."
msgstr "يجب أن تكون قيم فواصل خطوط كنتور عامل بايز موجبة."

msgid "Bayes factor contours breaks must be increasing."
msgstr "يجب أن تكون قيم فواصل خطوط كنتور عامل بايز متزايدة."

msgid "exp(Prior mean)"
msgstr "exp(المتوسط القبلي)"

msgid "Prior mean"
msgstr "المتوسط القبلي"

msgid "Prior standard deviation"
msgstr "الانحراف المعياري القبلي"

msgid "The default Bayes factor is based on unit information prior corresponding to a %1$s effect size, a normal distribution with mean = 0 and sd = %2$s."
msgstr ""
"يستند عامل بايز الافتراضي إلى توزيع وحدة المعلومات القبلي المقابل لحجم أثر "
"%1$s، وهو توزيع طبيعي بمتوسط = 0 وانحراف معياري = %2$s."

msgid "Bayesian Binomial Test"
msgstr "اختبار ذي الحدين البايزي"

msgid "- *Bayes factor*: If one-sided test is requested:\n  - BF+0: Bayes factor that quantifies evidence for the one-sided alternative hypothesis that the population mean is larger than the test value\n  - BF-0: Bayes factor that quantifies evidence for the one-sided alternative hypothesis that the population mean is smaller than the test value\n- BF0+: Bayes factor that quantifies evidence for the null hypothesis relative to the one-sided alternative hypothesis that the population mean is larger than the test value\n- BF0-: Bayes factor that quantifies evidence for the null hypothesis relative to the one-sided alternative hypothesis that that the population mean is smaller than the test value\n  - **p**: p-value corresponding to t-statistic."
msgstr ""
"- *عامل بايز*: عند طلب اختبار أحادي الطرف:\n"
"  - BF+0: يقيس الدليل لصالح الفرضية البديلة أحادية الطرف بأن متوسط المجتمع "
"أكبر من قيمة الاختبار.\n"
"  - BF-0: يقيس الدليل لصالح الفرضية البديلة أحادية الطرف بأن متوسط المجتمع "
"أصغر من قيمة الاختبار.\n"
"- BF0+: يقيس الدليل لصالح الفرضية الصفرية مقابل البديلة أحادية الطرف بأن "
"متوسط المجتمع أكبر من قيمة الاختبار.\n"
"- BF0-: يقيس الدليل لصالح الفرضية الصفرية مقابل البديلة أحادية الطرف بأن "
"متوسط المجتمع أصغر من قيمة الاختبار.\n"
"  - **p**: قيمة p المقابلة لإحصاء t."

msgid "Successes"
msgstr "حالات النجاح"

